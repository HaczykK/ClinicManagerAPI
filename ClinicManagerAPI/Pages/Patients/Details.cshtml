@page "{id:int}"
@model ClinicManagerAPI.Pages.Patients.DetailsModel
@{
    ViewData["Title"] = "Szczegóły pacjenta";
    var patient = Model.Patient!;
}

<div class="page-header d-flex justify-content-between align-items-start">
    <div>
        <h1 class="h2 mb-1">@patient.FirstName @patient.LastName</h1>
        <p class="text-muted mb-0">PESEL: @patient.Pesel</p>
        @if (!string.IsNullOrEmpty(patient.InsuranceNumber))
        {
            <p class="text-muted mb-0">Ubezpieczenie: @patient.InsuranceNumber</p>
        }
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary">Powrót do listy</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Wizyty pacjenta</h2>
    </div>
    <div class="card-body p-0">
        @if (Model.Visits.Count == 0)
        {
            <p class="text-muted p-3 mb-0">Brak wizyt.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Data</th>
                            <th>Lekarz</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var visit in Model.Visits)
                        {
                            <tr>
                                <td>@visit.Date.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@(visit.AssignedDoctorName ?? "—")</td>
                                <td>
                                    <span class="badge @DisplayHelpers.StatusBadgeClass(visit.Status)">
                                        @DisplayHelpers.FormatVisitStatus(visit.Status)
                                    </span>
                                </td>
                                <td>
                                    <a asp-page="/Visits/Details" asp-route-id="@visit.Id" class="btn btn-sm btn-outline-primary">Szczegóły</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Kartoteka medyczna</h2>
    </div>
    <div class="card-body">
        @if (User.IsInRole("Admin") || User.IsInRole("Rejestratorka") || User.IsInRole("Lekarz"))
        {
            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="row g-2 mb-4">
                <input type="hidden" name="id" value="@patient.Id" />
                <div class="col-md-5">
                    <input type="file" name="file" class="form-control" required />
                </div>
                <div class="col-md-5">
                    <input asp-for="UploadDescription" class="form-control" placeholder="Opis dokumentu (opcjonalnie)" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Dodaj dokument</button>
                </div>
            </form>
        }

        @if (Model.MedicalRecords.Count == 0)
        {
            <p class="text-muted mb-0">Brak dokumentów w kartotece.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Plik</th>
                            <th>Opis</th>
                            <th>Data dodania</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.MedicalRecords)
                        {
                            <tr>
                                <td>
                                    <a href="@record.DocumentScanUrl" target="_blank" rel="noopener">
                                        @(record.FileName ?? "Pobierz dokument")
                                    </a>
                                </td>
                                <td>@(record.Description ?? "—")</td>
                                <td>@record.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form method="post" asp-page-handler="DeleteRecord" class="d-inline"
                                              onsubmit="return confirm('Usunąć ten dokument?');">
                                            <input type="hidden" name="id" value="@patient.Id" />
                                            <input type="hidden" name="recordId" value="@record.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
