@page
@model ClinicManagerAPI.Pages.Patients.CreateModel
@{
    ViewData["Title"] = "Dodaj pacjenta";
}

<div class="page-header">
    <h1 class="h2">Dodaj pacjenta</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.FirstName" class="form-label">Imię</label>
                        <input asp-for="Input.FirstName" class="form-control" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.LastName" class="form-label">Nazwisko</label>
                        <input asp-for="Input.LastName" class="form-control" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Pesel" class="form-label">PESEL</label>
                        <input asp-for="Input.Pesel" class="form-control" maxlength="11" />
                        <span asp-validation-for="Input.Pesel" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.InsuranceNumber" class="form-label">Numer ubezpieczenia</label>
                        <input asp-for="Input.InsuranceNumber" class="form-control" />
                        <span asp-validation-for="Input.InsuranceNumber" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Zapisz</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Anuluj</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
