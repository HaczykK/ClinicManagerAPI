@page
@model ClinicManagerAPI.Pages.Patients.IndexModel
@{
    ViewData["Title"] = "Pacjenci";
}

<div class="d-flex justify-content-between align-items-center page-header">
    <div>
        <h1 class="h2 mb-0">Pacjenci</h1>
        <p class="text-muted mb-0">Lista pacjentów przychodni</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Rejestratorka"))
    {
        <a asp-page="Create" class="btn btn-primary">Dodaj pacjenta</a>
    }
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-8">
        <input type="text" name="query" value="@Model.Query" class="form-control" placeholder="Szukaj po imieniu, nazwisku lub PESEL..." />
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Szukaj</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Wyczyść</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Imię</th>
                    <th>Nazwisko</th>
                    <th>PESEL</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Patients.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-muted text-center py-4">Brak pacjentów do wyświetlenia.</td>
                    </tr>
                }
                else
                {
                    @foreach (var patient in Model.Patients)
                    {
                        <tr>
                            <td>@patient.FirstName</td>
                            <td>@patient.LastName</td>
                            <td>@patient.Pesel</td>
                            <td class="table-actions text-end">
                                <a asp-page="Details" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary">Szczegóły</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@patient.Id" class="d-inline"
                                          onsubmit="return confirm('Czy na pewno usunąć tego pacjenta?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.IsSearchMode && Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link" asp-page="Index" asp-route-pageNumber="@(Model.PageNumber - 1)">Poprzednia</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Strona @Model.PageNumber z @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-page="Index" asp-route-pageNumber="@(Model.PageNumber + 1)">Następna</a>
            </li>
        </ul>
    </nav>
}
