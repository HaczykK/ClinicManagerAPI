@page
@model ClinicManagerAPI.Pages.Medications.IndexModel
@{
    ViewData["Title"] = "Leki";
}

<div class="page-header">
    <h1 class="h2">Katalog leków</h1>
    <p class="text-muted">Zarządzanie lekami w przychodni</p>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-8">
        <input type="text" name="name" value="@Model.Name" class="form-control" placeholder="Filtruj po nazwie leku..." />
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Szukaj</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Wyczyść</a>
    </div>
</form>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h2 class="h6 mb-0">Dodaj nowy lek</h2>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label asp-for="CreateInput.Name" class="form-label">Nazwa</label>
                <input asp-for="CreateInput.Name" class="form-control" />
                <span asp-validation-for="CreateInput.Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CreateInput.UnitPrice" class="form-label">Cena jednostkowa (zł)</label>
                <input asp-for="CreateInput.UnitPrice" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="CreateInput.UnitPrice" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Dodaj</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nazwa</th>
                    <th>Cena jednostkowa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Medications.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-muted text-center py-4">Brak leków w katalogu.</td>
                    </tr>
                }
                else
                {
                    @foreach (var medication in Model.Medications)
                    {
                        <tr>
                            <td>@medication.Name</td>
                            <td>@medication.UnitPrice.ToString("N2") zł</td>
                            <td class="table-actions text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#editModal-@medication.Id">
                                    Edytuj
                                </button>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@medication.Id" class="d-inline"
                                          onsubmit="return confirm('Czy na pewno usunąć ten lek?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                                    </form>
                                }

                                <div class="modal fade" id="editModal-@medication.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form method="post" asp-page-handler="Edit">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Edytuj lek</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <input type="hidden" name="EditId" value="@medication.Id" />
                                                    <div class="mb-3">
                                                        <label class="form-label">Nazwa</label>
                                                        <input name="EditInput.Name" value="@medication.Name" class="form-control" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label">Cena jednostkowa (zł)</label>
                                                        <input name="EditInput.UnitPrice" value="@medication.UnitPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                               class="form-control" type="number" step="0.01" min="0" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
                                                    <button type="submit" class="btn btn-primary">Zapisz</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
