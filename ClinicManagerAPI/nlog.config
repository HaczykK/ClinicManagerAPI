<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <targets>
    <!-- Plik ogólny – wszystkie logi Info+ -->
    <target xsi:type="File"
            name="allFile"
            fileName="${basedir}/logs/app-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner= | ${exception:format=tostring}}"
            archiveEvery="Day"
            maxArchiveFiles="30"
            encoding="utf-8" />

    <!-- Plik błędów – tylko Error+ -->
    <target xsi:type="File"
            name="errorFile"
            fileName="${basedir}/logs/errors-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner= | ${exception:format=tostring}}"
            archiveEvery="Day"
            maxArchiveFiles="60"
            encoding="utf-8" />
  </targets>

  <rules>
    <!-- Logi Info i wyżej → plik ogólny -->
    <logger name="*" minlevel="Info" writeTo="allFile" />

    <!-- Logi Error i wyżej → plik błędów -->
    <logger name="*" minlevel="Error" writeTo="errorFile" />
  </rules>

</nlog>
